# Copy to .env and fill in real values. Never commit .env.
# Supabase: https://supabase.com/dashboard/project/_/settings/api

VITE_SUPABASE_PROJECT_ID=your-project-id-here
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
VITE_SUPABASE_URL=https://your-project-id-here.supabase.co

# Server-only scripts (bootstrap-sleeper-ids, import-rookies, etc.) — no VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=paste-long-jwt-here

# Settings → "Sync player teams" admin control (not secret; mirror ADMIN_SYNC_USER_IDS on Edge).
VITE_SYNC_ADMIN_USER_ID=00000000-0000-0000-0000-000000000000

# Production site URL (no trailing slash). SEO, sitemap, password-reset links, OG tags.
VITE_SITE_URL=https://your-domain.com

# Pick Six rules acceptance (reCAPTCHA v2 checkbox). https://www.google.com/recaptcha/admin
VITE_RECAPTCHA_SITE_KEY=your-recaptcha-site-key-here
